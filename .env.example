# ==============================================================================
# Edge Systems Collection — Monorepo Environment Configuration Reference
# ==============================================================================

# Strategy B: Dynamic Base Path Overrides
# By default, each sub-project builds with base path '/<slug>/' for subpath deployments.
# For custom subdomain deployments (e.g., https://barter-bridge.example.com/),
# override VITE_BASE_PATH to '/' in the sub-project's .env.production.local file.
# VITE_BASE_PATH=/

# Strategy B: Cross-Application Custom Subdomain / Remote Host Overrides
# EcosystemNav automatically reads these variables to link between applications
# across independent domains or subdomains. If unset, it falls back to local ports
# (during development) or subpaths '/<slug>/' (in production).
VITE_APP_HUB_URL=https://hub.edgesystems.dev/
VITE_APP_BARTER_BRIDGE_URL=https://barter-bridge.edgesystems.dev/
VITE_APP_DIAGNOSTIC_LIQUIDITY_URL=https://diagnostic-liquidity.edgesystems.dev/
VITE_APP_HORIZON_SCRAPE_URL=https://horizon-scrape.edgesystems.dev/
VITE_APP_PARAMETRIC_PULSE_URL=https://parametric-pulse.edgesystems.dev/
VITE_APP_SACRIFICIAL_PATHWAYS_URL=https://sacrificial-pathways.edgesystems.dev/
